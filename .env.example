# KAAVAL — environment variables
# Every variable named across all four build documents. Copy to .env and
# fill in real values locally; never commit a populated .env.
#
# THIS FILE IS TRACKED BY GIT — it is a template only. Never paste a real
# key here; put it in .env, which .gitignore excludes.
#
# FORMAT NOTE: a blank value must not carry a trailing "# comment" on the
# same line — python-dotenv would read the comment text itself as the value.
# Comments for blank-valued keys go on their own line above them.

# --- Gateway core (Rohith) ---
DATABASE_URL=sqlite:///./kaaval.db
WEBAUTHN_RP_ID=kaaval-demo.local          # must match the browser SDK's config exactly
WEBAUTHN_RP_ORIGIN=https://kaaval-demo.local
NONCE_TTL_SECONDS=30                      # single-use nonce validity window
REQUEST_FRESHNESS_WINDOW_SECONDS=30       # timestamp check window (TRD §6.1 step 7)
WEBAUTHN_CHALLENGE_TTL_SECONDS=120        # how long a pending register/login ceremony stays valid
KAAVAL_DEFAULT_MODE=protected             # demo app default when ?mode= is absent: baseline | protected
# Blank = derive from WEBAUTHN_RP_ORIGIN's scheme; set true/false to force.
SESSION_COOKIE_SECURE=

# --- Radar + Guardian (Adhi) ---
MOCK_ORG_ID=mock-org-01                   # used everywhere Radar output is labeled, per NFR-5

# --- Dashboard + Chronicle (Sai) ---
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:8000
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000  # backend CORS allow-list for the dashboard
# Chronicle's LLM runs on Groq. Leave the key blank to use the deterministic
# fallback narrative instead of a live call — Chronicle degrades, never fails.
# GROQ_API and LLM_API_KEY are accepted as aliases for this key.
GROQ_API_KEY=
CHRONICLE_LLM_MODEL=openai/gpt-oss-120b   # verify against GET /openai/v1/models for your account
CHRONICLE_LLM_REASONING_EFFORT=low        # low|medium|high; blank omits it (needed for non-reasoning models)
CHRONICLE_LLM_TIMEOUT_SECONDS=5           # per-call timeout; Chronicle does not retry, it falls back
CHRONICLE_FALLBACK_MODE=false             # flip to true to force the scripted fallback narrative, for rehearsal
